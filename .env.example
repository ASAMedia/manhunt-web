# Kopieren nach .env und anpassen:  cp .env.example .env
# Danach genügt immer:  docker compose pull && docker compose up -d

# Pflicht: Passwort für die Spielleitung (mindestens 8 Zeichen)
ADMIN_PASSWORD=

# Optional: Passwort für eine zweite Aufsichtsperson (mind. 8 Zeichen, anders als ADMIN_PASSWORD).
# Die Aufsicht sieht alles, bearbeitet Notfälle/Warnungen und sendet Nachrichten,
# darf aber nichts starten, einstellen, entfernen oder löschen.
SUPERVISOR_PASSWORD=

# Zusatzdienste (kommagetrennt):
#   caddy       eigene Domain mit automatischem HTTPS (DOMAIN unten setzen, Ports 80/443)
#   tunnel      kostenloser Cloudflare-Schnelltunnel ohne Domain
#   autoupdate  neue Versionen automatisch holen, täglich 4 Uhr nachts
# Leer = nur die App auf http://127.0.0.1:3000 (hinter einem vorhandenen Reverse Proxy)
COMPOSE_PROFILES=caddy,autoupdate

# Öffentliche Adresse für QR-Codes (z. B. https://manhunt.example.de).
# Leer lassen = die Adresse, über die du die Admin-Seite geöffnet hast.
PUBLIC_URL=

# Nur für das Caddy-Profil: deine Domain (DNS muss auf diesen Server zeigen)
DOMAIN=

# Angaben für die Datenschutz-Seite (/datenschutz) – bitte ausfüllen, bevor Schüler mitspielen:
# Verantwortlich ist die Schule, z. B. „Musterschule, Musterstraße 1, 99423 Weimar“
PRIVACY_CONTROLLER=
# Datenschutz-Kontakt (Datenschutzbeauftragte/r der Schule), z. B. „Frau Muster, datenschutz@schule-x.de“
PRIVACY_CONTACT=
# Wo steht der Server? z. B. „Hetzner Online GmbH, Rechenzentrum Falkenstein (Deutschland)“ – leer lassen bei eigenem Gerät
PRIVACY_HOSTING=

# Räume (inkl. aller Standortdaten) werden so viele Tage nach der letzten Aktivität
# automatisch gelöscht. Laufende Spiele nie. 0 = nie automatisch löschen.
AUTO_DELETE_DAYS=7

# Kartenkacheln über diesen Server laden und 7 Tage zwischenspeichern (1 = an, 0 = aus).
# An: schont OpenStreetMap, Handys sprechen nur mit deinem Server, Offline-Karte möglich.
TILE_PROXY=1
# Obergrenze für den Kartenspeicher in MB (Standard 1000)
# TILE_CACHE_MAX_MB=1000

# Optional: Kartenmitte beim Öffnen (Standard: Berlin-Mitte)
MAP_CENTER=52.517,13.3889

# Optional: lokaler Port für http://127.0.0.1
LOCAL_PORT=3000

# Optional: anderes Docker-Image (Standard: ghcr.io/asamedia/manhunt-web:latest)
# MANHUNT_IMAGE=ghcr.io/asamedia/manhunt-web:latest
